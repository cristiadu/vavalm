{
  "name": "@cristiadu/vavalm-desktop",
  "version": "2.0.0",
  "description": "VaValM desktop application",
  "homepage": "https://github.com/cristiadu/vavalm",
  "author": "Cristiano Faustino",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm tsc --project tsconfig.build.json && pnpm tsc-alias --project tsconfig.build.json",
    "build:resources": "pnpm --dir .. create-env-file && pnpm --filter @cristiadu/vavalm-api build:desktop && cross-env NEXT_OUTPUT_STANDALONE=true NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:18000/api pnpm --filter @cristiadu/vavalm-ui build",
    "dev": "pnpm build:resources && pnpm build && electron .",
    "dist": "pnpm build:resources && pnpm build && electron-builder --publish never",
    "lint": "pnpm eslint . --config eslint.config.js && pnpm tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist release",
    "create-env-file": "echo 'Desktop configuration is managed by Electron'",
    "upgrade:dependencies": "pnpm upgrade --latest"
  },
  "dependencies": {
    "async-exit-hook": "^2.0.1",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "18.4.0-beta.17",
    "@embedded-postgres/linux-ia32": "18.4.0-beta.17",
    "@embedded-postgres/linux-ppc64": "18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/async-exit-hook": "^2.0.2",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "10.9.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-n": "18.3.0",
    "globals": "17.11.0",
    "rimraf": "6.1.3",
    "tsc-alias": "1.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.cristiadu.vavalm",
    "productName": "VaValM",
    "executableName": "VaValM",
    "artifactName": "VaValM-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../api/dist",
        "to": "app-server/api/dist"
      },
      {
        "from": "../api/docs/openapi.yaml",
        "to": "app-server/api/docs/openapi.yaml"
      },
      {
        "from": "../api/package.json",
        "to": "app-server/api/package.json"
      },
      {
        "from": "../ui/.next/standalone",
        "to": "app-server/ui"
      },
      {
        "from": "../ui/.next/standalone/node_modules/.pnpm",
        "to": "app-server/ui/node_modules/.pnpm"
      },
      {
        "from": "../ui/.next/static",
        "to": "app-server/ui/ui/.next/static"
      },
      {
        "from": "../ui/public",
        "to": "app-server/ui/ui/public"
      }
    ],
    "asar": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Cristiano Faustino"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "VaValM-${version}-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "VaValM-${version}-${os}-${arch}-portable.${ext}"
    }
  }
}
