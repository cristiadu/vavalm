{
  "name": "@cristiadu/vavalm",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "desktop:build": "pnpm --filter @cristiadu/vavalm-api build && NEXT_OUTPUT_STANDALONE=true pnpm --filter @cristiadu/vavalm-ui build && pnpm --filter @cristiadu/vavalm-desktop build",
    "desktop:package": "pnpm desktop:build && pnpm --filter @cristiadu/vavalm-desktop exec electron-builder",
    "desktop:start": "pnpm --filter @cristiadu/vavalm-desktop start",
    "create-env-file": "turbo create-env-file",
    "start": "pnpm --parallel -r start",
    "dev:docker:build": "docker compose build",
    "dev:docker:up": "./scripts/docker-init.sh",
    "dev:docker:down": "docker compose down --volumes",
    "dev:docker:logs": "./scripts/docker-logs-zip.sh",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "lint:fix": "pnpm --parallel -r lint:fix",
    "clean": "pnpm base:clean && pnpm --parallel -r clean",
    "migrate": "pnpm --filter @cristiadu/vavalm-api migrate",
    "localdb": "cd scripts && ./localdb.sh",
    "upgrade:dependencies": "pnpm base:upgrade:dependencies && pnpm --parallel -r upgrade:dependencies",
    "audit": "pnpm base:audit && pnpm --parallel -r audit fix",
    "generate:routes": "pnpm --filter @cristiadu/vavalm-api generate:routes",
    "generate:spec": "pnpm --filter @cristiadu/vavalm-api generate:spec",
    "base:clean": "rm -rf node_modules && rm -rf dist && rm -rf .turbo && find . -type d -name 'generated' -exec rm -rf {} +",
    "base:upgrade:dependencies": "pnpm upgrade --latest",
    "base:audit": "pnpm audit fix",
    "knip": "knip -c knip.config.ts",
    "knip:fix": "knip -c knip.config.ts --fix"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "knip": "^6.32.2",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "api",
    "ui"
  ]
}
