{
  "name": "@cristiadu/vavalm-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vavalm/vavalm.git"
  },
  "scripts": {
    "postinstall": "pnpm generate:spec && pnpm generate:routes && pnpm generate:client",
    "dev": "npm-run-all --parallel watch server",
    "watch": "webpack --watch --config webpack.config.js --mode development",
    "server": "nodemon --watch dist/bundle.js dist/bundle.js",
    "dev:built": "npm-run-all --parallel build start",
    "create-env-file": "cp .env.template .env",
    "build": "cross-env NODE_ENV=production pnpm generate:routes && pnpm generate:client && pnpm webpack --config webpack.config.js --mode production",
    "build:desktop": "cross-env VAVALM_DESKTOP_BUILD=true pnpm build && pnpm save:countries",
    "start": "wait-on dist/bundle.js && node dist/bundle.js",
    "test": "vitest run --exclude tests/api/pagination.test.ts && vitest run tests/api/pagination.test.ts",
    "check-health": "wait-on -t 60000 http://localhost:8000/api/health",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm eslint . --config  ./eslint.config.js",
    "lint:fix": "pnpm eslint . --config  ./eslint.config.js --fix",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf .turbo && rm -rf tests/coverage",
    "migrate": "cd src && pnpm sequelize-cli db:migrate",
    "generate:spec": "pnpm tsoa spec",
    "generate:routes": "pnpm tsoa routes",
    "generate:client": "pnpm openapi --input ./docs/openapi.yaml --output ./tests/generated/api --client fetch --name VavalMApi --indent 2",
    "save:countries": "tsx scripts/save-countries.ts"
  },
  "dependencies": {
    "body-parser": "^2.3.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-loader": "^10.1.1",
    "cross-env": "10.1.0",
    "domhandler": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "openapi-typescript-codegen": "^0.31.0",
    "ts-loader": "^9.6.2",
    "tsoa": "7.0.0-alpha.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "webpack": "5.109.2",
    "webpack-cli": "^7.2.3",
    "worker-plugin": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
