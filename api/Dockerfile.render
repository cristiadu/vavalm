# Build context is the repository root, not ./api.
#
# api/Dockerfile reaches the root lockfile through a named build context
# (`additional_contexts: parent_dir` in docker-compose.yml). Named contexts are a
# Compose/Buildx feature, so a plain `docker build` — which is what managed hosts
# run — cannot resolve them. This variant copies the same files from the root
# context instead, and starts the server under a heap cap that fits a small
# container.
FROM node:lts AS builder

WORKDIR /app

# Same layout api/Dockerfile produces, sourced from the repository root.
COPY api/ /app/
COPY pnpm-lock.yaml /app/pnpm-lock.yaml
# workspace config carries pnpm policies (e.g. allowBuilds) needed by pnpm install
COPY pnpm-workspace.yaml /app/pnpm-workspace.yaml

# pin pnpm to the workspace's packageManager version (see root package.json)
RUN npm install -g pnpm@11.9.0
RUN pnpm install

RUN pnpm build

# Verify the bundle exists
RUN ls -la dist/ && test -f dist/bundle.js

# Use Alpine for smaller image size
FROM node:lts-alpine AS runner

WORKDIR /app

# PORT is injected by the host; src/index.ts reads process.env.PORT.
ENV NODE_ENV=production

# webpack marks pg, express and sequelize as externals, so the bundle alone is
# not enough to boot — node_modules ships with it.
COPY --from=builder /app/dist /app/dist
COPY --from=builder /app/docs/openapi.yaml /app/docs/openapi.yaml
COPY --from=builder /app/node_modules /app/node_modules

COPY api/package.json /app/package.json
# use the builder's lockfile/workspace config so they match the installed node_modules
COPY --from=builder /app/pnpm-lock.yaml /app/pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml /app/pnpm-workspace.yaml

# install pnpm globally, pinned to the workspace's packageManager version
RUN npm install -g pnpm@11.9.0

# Create a non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs

RUN chown -R nodejs:nodejs /app

USER nodejs

# start under a heap cap the container can actually satisfy — the default start
# script asks for 4 GB, which makes a 512 MB instance OOM instead of collecting.
# Mirrors `start` otherwise, wait-on included: leading with `node dist/bundle.js`
# makes knip read the built bundle as a source entry point and report the whole
# src/ graph as unused.
CMD ["pnpm", "start:constrained"]
