# JWT Secret used for signing and verifying JSON Web Tokens
JWT_SECRET=my-secret-key

# Rate limit: max requests per 15-minute window. Set high in dev/test to avoid hitting the limit.
RATE_LIMIT_MAX=10000

# How often the match scheduler polls for due matches, in milliseconds.
# Production leaves this unset and polls once a minute; dev and CI poll quickly
# so the scheduler test does not sit through a full cycle.
SCHEDULER_CHECK_INTERVAL=2000
